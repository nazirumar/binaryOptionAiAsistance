# ---------------------------------------------------------------------------
# Nazbeen Academy Binary Ai Asisstance - environment configuration
# Copy to `.env` and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# Core
DJANGO_SETTINGS_MODULE=config.settings.dev
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key(50))"
# If the value contains `$`, wrap it in SINGLE quotes: DJANGO_SECRET_KEY='...'
# (docker compose would otherwise interpolate `$name` to empty — the app and the
# container must see the identical key. `scripts/check_env_coverage.py` enforces this.)
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated absolute origins, e.g. https://example.com,https://app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Comma-separated browser origins allowed to call the API (leave empty if the
# frontend is same-origin, which is the default deployment).
DJANGO_CORS_ALLOWED_ORIGINS=

# Production transport security (config.settings.prod) --------------------
# Enforce HTTPS -> 301 redirect. Disable ONLY when TLS terminates upstream
# and is confirmed working (e.g. behind a correctly configured reverse proxy).
DJANGO_SECURE_SSL_REDIRECT=True
# HSTS max-age seconds. Raise to 31536000 once HTTPS is confirmed stable;
# browsers cannot undo HSTS before it expires.
DJANGO_SECURE_HSTS_SECONDS=86400

# API surface
# Docs/schema endpoints. MUST be False in production (they expose the API map).
API_DOCS_ENABLED=True
# Global request body size limit (bytes). Oversized payloads are rejected.
MAX_UPLOAD_SIZE_BYTES=10485760

# Database ---------------------------------------------------------------
# Leave unset to use local SQLite (development only).
# Production (PostgreSQL, required):
# DATABASE_URL=postgres://user:password@localhost:5432/nazbeen_academy
DATABASE_URL=
DJANGO_DB_CONN_MAX_AGE=60

# Redis / Celery / Channels ---------------------------------------------
# Leave unset to use in-memory fallbacks (development only).
# Production MUST use Redis with a password and a private network:
#   redis://:<password>@redis:6379/0
# Never expose Redis on a public interface.
REDIS_URL=

# Docker Compose ---------------------------------------------------------
# compose.yaml (dev) and compose.prod.yaml interpolate these from this file
# (`docker compose` reads .env in the project directory automatically).
# POSTGRES_PASSWORD and REDIS_PASSWORD are REQUIRED: compose refuses to start
# until each holds a non-empty value. Set your own per environment — never
# reuse these placeholders anywhere real.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Optional overrides (compose defaults shown):
POSTGRES_USER=app
POSTGRES_DB=nazbeen_academy
POSTGRES_PORT=5432
REDIS_PORT=6379
WEB_PORT=8000
# Image tag for compose.prod.yaml; deploy.yml sets a per-release value.
IMAGE_TAG=nazbeen-academy:latest
CELERY_TASK_ALWAYS_EAGER=False
# Wall-clock limit for a single task (seconds). Screenshot analysis and
# backtests are the two long jobs; raise deliberately, not casually.
CELERY_TASK_TIME_LIMIT=300
# Soft limit: task gets a chance to clean up before the hard limit kills it.
CELERY_TASK_SOFT_TIME_LIMIT=240
# Retry policy for transient failures (e.g. DB blip). 0 retries = fail fast.
CELERY_TASK_DEFAULT_RETRY_DELAY=10
CELERY_TASK_MAX_RETRIES=3
# Re-deliver a task if a worker dies mid-execution. Required for correctness
# of long jobs; tasks must therefore be idempotent (they are: keyed by PK).
CELERY_TASK_ACKS_LATE=True
CELERY_TASK_REJECT_ON_WORKER_LOST=True
# Prefetch multiplier: 1 keeps memory bounded when several workers pull
# screenshot/backtest jobs, at the cost of slightly lower throughput.
CELERY_TASK_PREFETCH_MULTIPLIER=1
# Limit the number of concurrently running heavy jobs per worker.
CELERY_WORKER_CONCURRENCY=2
# Bound result retention so Redis does not grow without limit.
CELERY_RESULT_EXPIRES=86400
# Separate queues so a burst of screenshot jobs cannot starve market-data
# ingestion (and vice versa). Routing is defined in
# config/settings/base.py -> CELERY_TASK_ROUTES (not settable via env, because
# it is a nested mapping). Queues: vision, backtest, market, assistant,
# default. Start one worker per queue in production, e.g.:
#   celery -A config worker -Q market -c 2
#   celery -A config worker -Q vision -c 1
#   celery -A config worker -Q backtest -c 1

# Static / media
DJANGO_STATIC_ROOT=
DJANGO_MEDIA_ROOT=

# Chart vision / screenshot analysis (Phase 3) --------------------------
# Provider selects how screenshots are sent to a vision model:
#   mock   -> deterministic local fixture, no network (default; dev/tests)
#   openai -> any OpenAI-compatible /chat/completions endpoint
#   custom -> your own OpenAI-compatible endpoint (set VISION_LLM_BASE_URL)
# Credentials are read from the environment only and never stored or logged.
# A provider failure NEVER produces fabricated analysis: the run fails closed.
VISION_LLM_PROVIDER=mock
VISION_LLM_MODEL=
VISION_LLM_API_KEY=
VISION_LLM_BASE_URL=
VISION_LLM_TIMEOUT_SECONDS=60
VISION_LLM_MAX_RETRIES=2
VISION_LLM_BACKOFF_SECONDS=1.5
VISION_LLM_MAX_TOKENS=2048
VISION_LLM_TEMPERATURE=0.0

# Screenshot upload limits and secure storage. Screenshots are NEVER served
# from a public media URL; they are streamed only through an authenticated,
# owner-checked endpoint and retained for a bounded period.
VISION_MAX_UPLOAD_BYTES=8388608
VISION_MIN_WIDTH=200
VISION_MIN_HEIGHT=100
VISION_MAX_WIDTH=8000
VISION_MAX_HEIGHT=8000
VISION_MAX_PIXELS=40000000
VISION_PREPROCESS_MAX_DIMENSION=2000
# Defaults to <BASE_DIR>/private_media/screenshots when unset.
VISION_SCREENSHOT_ROOT=
VISION_SCREENSHOT_RETENTION_DAYS=30
VISION_ANALYSIS_MAX_ATTEMPTS=3
# A screenshot analysis left RUNNING longer than this (seconds) is treated as
# abandoned by a dead worker and recovered as failed so it can be retried.
VISION_ANALYSIS_STALE_SECONDS=900

# Screenshot upload/read API throttling.
VISION_UPLOAD_THROTTLE=30/minute
VISION_READ_THROTTLE=240/minute

# Reasoning LLM (Phase 8) -------------------------------------------------
# The reasoning model EXPLAINS results produced by the deterministic and
# statistical engines. It can never override an engine decision (NO TRADE
# stays NO TRADE) and can never invent a probability: only an approved,
# calibrated model may be quoted.
#   mock   -> deterministic local fixture, no network (default; dev/tests)
#   openai -> any OpenAI-compatible /chat/completions endpoint
REASONING_LLM_PROVIDER=mock
REASONING_LLM_MODEL=
REASONING_LLM_API_KEY=
REASONING_LLM_BASE_URL=
REASONING_LLM_TIMEOUT_SECONDS=30
REASONING_LLM_MAX_RETRIES=2
REASONING_LLM_MAX_TOKENS=512
REASONING_LLM_TEMPERATURE=0.1
# Opt-in live smoke test for the reasoning provider (tests/test_phase11_reasoning.py).
# Leave False: only set True deliberately to spend one real API request.
REASONING_LLM_LIVE_TEST=False
# If the reasoning provider fails (missing key, unreachable, errored), what the
# caller sees in `content` is governed here. Nothing is fabricated either way:
#   True  (default) -> the deterministic engine's own explanation from the
#                      request context is shown; success=False is recorded.
#   False           -> a fixed "Explanation unavailable" notice is shown
#                      instead, so a reader can tell the LLM did not take part.
REASONING_FALLBACK_ON_FAILURE=True

# Assistant / dashboard / journal API throttling --------------------------
ASSISTANT_UPLOAD_THROTTLE=30/minute
ASSISTANT_READ_THROTTLE=240/minute
DASHBOARD_THROTTLE=120/min
JOURNAL_THROTTLE=60/min

# MetaTrader 5 (Phase 2) --------------------------------------------------
# The web tier never needs these; the Windows worker reads them. Never commit
# real credentials. MT5_PASSWORD may instead be referenced indirectly via an
# MT5ConnectionProfile.credential_ref naming an environment variable.
MT5_PATH=
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=
MT5_TIMEOUT_MS=60000
MT5_PORTABLE=False
MT5_MAX_RETRIES=3
MT5_RETRY_BACKOFF_SECONDS=2.0
MT5_RETRY_BACKOFF_MAX_SECONDS=30.0
# Feed delay allowance (seconds) before a candle is treated as completed.
MT5_FEED_DELAY_SECONDS=5
# Bounded query limits and retention.
MT5_MAX_CANDLE_RANGE=5000
MT5_MAX_TICK_RANGE=10000
# Broker server clock offset, in minutes. MT5 times are the server's
# wall-clock, not UTC (e.g. a UTC+3 server labels the 15:00 UTC candle 18:00).
# Leave unset/blank to auto-detect from the terminal. Set explicitly (e.g. 180
# for UTC+3) to pin it and skip detection.
MT5_SERVER_TZ_OFFSET_MINUTES=
MT5_STALE_TICK_SECONDS=120
MT5_TICK_RETENTION_DAYS=7

# Worker <-> server authentication (leave unset to disable ingest endpoints).
MT5_WORKER_TOKEN=
MT5_WORKER_POLL_INTERVAL_SECONDS=15
MT5_WORKER_HEARTBEAT_TTL_SECONDS=90

# Default instruments/timeframes collected by the worker (comma-separated).
MT5_SYNC_SYMBOLS=EURUSD
MT5_SYNC_TIMEFRAMES=M1,M5

# API throttling
MARKET_READ_THROTTLE=240/minute
MARKET_INGEST_THROTTLE=1200/minute

# Market synchronization (Phase 4) ---------------------------------------
# Comparison between a screenshot analysis and stored MT5 candles. All values
# are pragmatic defaults, NOT scientifically validated thresholds; tune with
# care and re-run the matcher/comparator tests after changing them.
SYNC_MAX_CANDLES=200
SYNC_MIN_OVERLAP_CANDLES=3
SYNC_DIRECTION_MATCH_MIN=0.75
SYNC_DIRECTION_PARTIAL_MIN=0.5
SYNC_DOJI_BODY_RATIO_MAX=0.12
SYNC_BODY_BAND_SMALL_MAX=0.25
SYNC_BODY_BAND_MEDIUM_MAX=0.60
SYNC_WICK_BAND_SMALL_MAX=0.20
SYNC_WICK_BAND_MEDIUM_MAX=0.45
SYNC_BODY_RATIO_TOLERANCE=0.30
SYNC_WICK_RATIO_TOLERANCE=0.35
# Freshness policy: how old a screenshot / MT5 candle may be before STALE_DATA.
SYNC_SCREENSHOT_MAX_AGE_SECONDS=3600
SYNC_MT5_MAX_CANDLE_AGE_SECONDS=900
SYNC_TIMESTAMP_TOLERANCE_SECONDS=5
SYNC_MIN_STRUCTURE_OVERLAP=5
SYNC_STRUCTURE_AGREE_MIN=0.70
SYNC_SWING_LOOKBACK=2
# Default UTC offset (minutes) used to interpret naive chart timestamps.
SYNC_DEFAULT_TZ_OFFSET_MINUTES=0
SYNC_CONFIG_VERSION=1.0
SYNC_VERIFY_THROTTLE=60/minute
SYNC_READ_THROTTLE=240/minute

# Price-action knowledge engine (Phase 5) --------------------------------
# Deterministic detection thresholds. Pragmatic defaults only; NOT validated
# market parameters and carrying no predictive claim. See
# apps/price_action/services/config.py for descriptions of each value.
PA_SWING_LOOKBACK=2
PA_MIN_SWINGS_FOR_TREND=2
PA_EQUAL_LEVEL_TOLERANCE=0.0005
PA_CONSOLIDATION_MAX_WIDTH=0.0025
PA_CONSOLIDATION_MIN_CANDLES=5
PA_ZONE_TOLERANCE=0.0015
PA_ZONE_MIN_TOUCHES=2
PA_REJECTION_WICK_MIN=0.5
PA_BREAKOUT_CLOSE_MARGIN=0.0005
PA_RETEST_WINDOW=5
PA_DOJI_BODY_RATIO_MAX=0.12
PA_SMALL_BODY_RATIO_MAX=0.30
PA_STRONG_BODY_RATIO_MIN=0.60
PA_STRONG_RANGE_MULTIPLE=1.2
PA_EXTENDED_RUN_LENGTH=3
PA_SEQUENCE_SIGNATURE_LENGTH=3
PA_SIMILAR_SEQUENCE_MIN_SAMPLES=3
PA_SIMILAR_SEQUENCE_MIN_SIMILARITY=1.0
PA_SWEEP_MIN_PENETRATION=0.0
PA_OPENING_GAP_MIN_SIZE=0.0
PA_HIGH_VOLUME_MULTIPLE=1.5
PA_LOW_VOLUME_MULTIPLE=0.6
PA_NARROW_RANGE_MULTIPLE=0.7
PA_WIDE_RANGE_MULTIPLE=1.3
PA_VOLUME_LOOKBACK=20
PA_HIGH_VOLATILITY_MULTIPLE=1.5
PA_LOW_VOLATILITY_MULTIPLE=0.6
PA_MAX_CANDLES=500
PA_MIN_CANDLES=3
PA_KNOWLEDGE_VERSION=1.0

# Live signals monitor (Phase 15) -----------------------------------------
# Automatic closed-candle monitoring. Research / paper only: no trade is ever
# executed, no probability is invented, and only a strategy with
# decision_use_approved AND research_status == "approved" may carry a direction.
# Instruments the system watches, as comma-separated "CANONICAL:TIMEFRAME"
# entries (optional third field ":otc" for an OTC feed). Timeframes: M1,M2,M3,M5,M15.
# Empty (default) -> the monitor reports UNAVAILABLE rather than pretending.
LIVE_SIGNAL_MONITORS=
# Closed-candle source: db  -> already-persisted MarketCandle rows (default)
#                       mt5 -> fetch through a connected MT5 terminal (Windows worker)
LIVE_SIGNAL_PROVIDER=db
# HTMX poll interval (seconds) for the dashboard status/feed fragments.
LIVE_SIGNAL_POLL_SECONDS=15

# Security / logging
# Level: DEBUG|INFO|WARNING|ERROR. Use WARNING+ in production.
DJANGO_LOG_LEVEL=INFO
# Formatter: "verbose" (human, dev) or "json" (machine, prod).
DJANGO_LOG_FORMATTER=verbose
# Optional error tracking. Empty DSN (default) disables it. Initialized only
# by config.settings.prod, which requires sentry-sdk from requirements/prod.txt
# when a DSN is set. NEVER commit a real DSN.
SENTRY_DSN=
# Comma-separated header names whose VALUES are masked in every log record
# (message text and structured extras) by apps.core.logging.RedactHeadersFilter,
# for both the verbose and JSON formatters. Scope: log output only — request or
# response bodies are not scanned.
DJANGO_LOG_REDACT_HEADERS=Authorization,Cookie,X-API-Key
